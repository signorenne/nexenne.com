@startuml pcnt_crossed_channels_en
left to right direction

rectangle "Signal A" as A
rectangle "Signal B" as B
component "PCNT channel 0" as C0
component "PCNT channel 1" as C1
rectangle "PCNT unit\nx4 counter" as U
rectangle "Extended position\nand watch points" as OUT

A --> C0 : edge
B --> C0 : level
B --> C1 : edge
A --> C1 : level
C0 --> U : increment / decrement
C1 --> U : increment / decrement
U --> OUT
@enduml
